
@model List<Espacio>

@{
    ViewData["Title"] = "Espacios";
}

<h1>Espacios disponibles</h1>

<div id="contenedorEspacios">

    @foreach (Espacio espacio in Model)
    {
        <div class="tarjeta-espacio" data-id="@espacio.Id">

            <img src="@Url.Content("~/Imagenes/" + espacio.Imagen)" alt="@espacio.Nombre">

            <h2>@espacio.Nombre</h2>

            <p>@espacio.Descripcion</p>

            <p>Capacidad: @espacio.Capacidad personas</p>

            <a href="@Url.Action("Detalle", "Espacios", new { id = espacio.Id })">
                Ver detalle
            </a>

        </div>
    }

</div>

<input type="hidden" id="ultimoId" value="@(Model.Count > 0 ? Model[Model.Count - 1].Id : 0)">

@if (Model.Count == 8)
{
    <button id="botonVerMas">Ver más</button>
}

<script src="~/js/espacios.js"></script>
